---
interface Props {
  // "sm" for stack tags on cards, "md" for the "Currently learning" row.
  size?: 'sm' | 'md';
}

const { size = 'sm' } = Astro.props;
---

<span class:list={['pill', size]}><slot /></span>

<style>
  .pill {
    display: inline-block;
    font-family: var(--font-mono);
    border: 1px solid var(--outline);
    border-radius: 999px;
  }

  .sm {
    font-size: 12px;
    color: var(--muted);
    padding: 4px 10px;
  }

  .md {
    font-size: 14px;
    color: var(--text);
    padding: 6px 14px;
  }
</style>
