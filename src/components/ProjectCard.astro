---
import Pill from './Pill.astro';
import { demoText, projectLabel, type Project } from '../projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, stack, demoUrl, screenshot } = project.data;
const label = projectLabel(project);
---

<article class="card">
  {
    screenshot ? (
      <img class="shot" src={screenshot} alt={`Screenshot of ${title}`} loading="lazy" />
    ) : (
      <div class="shot placeholder">[screenshot]</div>
    )
  }
  {label && <p class="eyebrow">{label}</p>}
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
  {
    stack.length > 0 && (
      <ul class="stack" aria-label="Built with">
        {stack.map((item) => (
          <li>
            <Pill>{item}</Pill>
          </li>
        ))}
      </ul>
    )
  }
  <div class="links">
    <a href={`/projects/${project.id}`} class="writeup">Read the write-up →</a>
    {demoUrl && <a href={demoUrl} class="demo">{demoText(project)} ↗</a>}
  </div>
</article>

<style>
  .card {
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shot {
    height: 168px;
    width: 100%;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .placeholder {
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  h3 {
    font-size: 24px;
  }

  .summary {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  .stack {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* margin-top: auto pins the links to the bottom so cards in a row line up. */
  .links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }

  .links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 15px;
  }

  .writeup {
    font-weight: 600;
  }

  .demo {
    color: var(--muted);
  }
</style>
