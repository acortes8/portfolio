{
  // Must match the project name in the Cloudflare dashboard, or the build fails.
  "name": "portfolio",
  // Locks in Cloudflare's runtime behavior as of this date.
  "compatibility_date": "2026-10-29",
  // Serve only at alejandrocortes.dev, not portfolio.<account>.workers.dev.
  // Must live here: turning it off in the dashboard is undone by the next deploy.
  "workers_dev": false,
  "assets": {
    // Astro's build output.
    "directory": "./dist",
    // Serve our 404.html for unknown URLs instead of a blank 404.
    "not_found_handling": "404-page",
    // Serve /projects directly; redirect /projects/ to it. Matches how our links are written.
    "html_handling": "drop-trailing-slash"
  }
}
